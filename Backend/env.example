# Example environment variables for Marketplace-Connector backend
# ----------------------------------------------------------
# Server configuration
PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string (Prisma format)
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL=postgresql://username:password@localhost:5432/marketplace_connector

# JWT configuration
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Key untuk enkripsi kredensial akun Akulaku (32+ karakter, jangan diganti setelah ada data)
AKULAKU_ENC_KEY=your_akulaku_encryption_key_here

# ---- Akulaku browser automation (Fase 3) ----
# Semua selektor bisa berubah sewaktu-waktu; sesuaikan dengan UI Seller Center.
# Login interaktif (sekali, untuk lewati OTP): npm run akulaku:login -- <accountId>
AKULAKU_BASE_URL=https://ec-vendor.akulaku.com/ec-vendor
AKULAKU_LOGIN_PATH=/user/login
AKULAKU_USERNAME_SELECTOR=#login_email
AKULAKU_PASSWORD_SELECTOR=#login_pwd
AKULAKU_LOGIN_SUBMIT_SELECTOR=button[type="submit"]
AKULAKU_LOGGED_IN_SELECTOR=
AKULAKU_HEADLESS=true

# Halaman form posting produk (diverifikasi ke UI asli Akulaku)
AKULAKU_POST_URL=/product/create
AKULAKU_POST_NAME_SELECTOR=#name
AKULAKU_POST_CATEGORY_SELECTOR=#categoryListValue
AKULAKU_POST_BRAND_SELECTOR=#brandId
AKULAKU_POST_PRICE_SELECTOR=#skus_0_originalPrice
AKULAKU_POST_STOCK_SELECTOR=#skus_0_stock
AKULAKU_POST_SKU_SELECTOR=#skus_0_goodsInfos
AKULAKU_POST_WEIGHT_SELECTOR=#weight
AKULAKU_POST_LENGTH_SELECTOR=#length
AKULAKU_POST_WIDTH_SELECTOR=#width
AKULAKU_POST_HEIGHT_SELECTOR=#height
AKULAKU_POST_IMAGE_INPUT_SELECTOR=input[type="file"]
AKULAKU_POST_SUBMIT_TEXT=Submit Produk
AKULAKU_POST_SUCCESS_SELECTOR=
# Kategori wajib; jalur dipisah "/" (level cascader Akulaku)
AKULAKU_POST_CATEGORY_PATH=Gadget & Digital/Aksesoris Digital/Kartu Memori Digital
# Spesifikasi khas kategori (JSON). Kosongkan bila tidak perlu.
AKULAKU_POST_SPECS={}

# Halaman daftar order
AKULAKU_ORDERS_URL=/order/list
AKULAKU_ORDERS_ROW_SELECTOR=tbody tr
AKULAKU_ORDER_ID_SELECTOR=
AKULAKU_ORDER_ROW_LIMIT=20

# Worker
WORKER_POLL_INTERVAL_MS=5000
