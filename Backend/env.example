# Example environment variables for Marketplace-Connector backend
# ----------------------------------------------------------
# Server configuration
PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string (Prisma format)
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL=postgresql://username:password@localhost:5432/marketplace_connector

# JWT configuration
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Key untuk enkripsi kredensial akun Akulaku (32+ karakter, jangan diganti setelah ada data)
AKULAKU_ENC_KEY=your_akulaku_encryption_key_here

# ---- Akulaku browser automation (Fase 3) ----
# Semua selektor bisa berubah sewaktu-waktu; sesuaikan dengan UI Seller Center.
AKULAKU_BASE_URL=https://seller.akulaku.com
AKULAKU_LOGIN_PATH=/login
AKULAKU_USERNAME_SELECTOR=input[name="username"], input[type="email"]
AKULAKU_PASSWORD_SELECTOR=input[type="password"]
AKULAKU_LOGIN_SUBMIT_SELECTOR=button[type="submit"]
AKULAKU_LOGGED_IN_SELECTOR=
AKULAKU_HEADLESS=true

# Halaman form posting produk
AKULAKU_POST_URL=/product/new
AKULAKU_POST_NAME_SELECTOR=input[name="title"], input[name="name"]
AKULAKU_POST_DESC_SELECTOR=textarea[name="description"]
AKULAKU_POST_PRICE_SELECTOR=input[name="price"]
AKULAKU_POST_STOCK_SELECTOR=input[name="stock"]
AKULAKU_POST_IMAGE_INPUT_SELECTOR=input[type="file"]
AKULAKU_POST_SUBMIT_SELECTOR=button[type="submit"]
AKULAKU_POST_SUCCESS_SELECTOR=

# Halaman daftar order
AKULAKU_ORDERS_URL=/orders
AKULAKU_ORDERS_ROW_SELECTOR=[data-testid="order-row"], tr.order-row
AKULAKU_ORDER_ID_SELECTOR=[data-testid="order-id"], .order-id
AKULAKU_ORDER_ROW_LIMIT=20

# Worker
WORKER_POLL_INTERVAL_MS=5000
