# Example environment variables for Marketplace-Connector backend
# ----------------------------------------------------------
# Server configuration
PORT=3000
# WAJIB 'production' di VPS (menyembunyikan stack trace error)
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173

# ---- Database ----
# OPSI A (disarankan, paling cepat): PostgreSQL di VPS yang sama dengan API.
#   Query ~1-5 ms karena tidak melewati jaringan.
#   Install: sudo DB_PASSWORD='...' bash deploy/db/01-install-postgres.sh
DATABASE_URL=postgresql://enzyy:PASSWORD@127.0.0.1:5432/enzyy?schema=public
DIRECT_URL=postgresql://enzyy:PASSWORD@127.0.0.1:5432/enzyy?schema=public

# OPSI B: Supabase / pooler (lebih lambat ~470 ms/query, batas 15 koneksi).
#   Runtime wajib transaction pooler (port 6543) + pgbouncer + connection_limit kecil.
#   DIRECT_URL tetap port 5432 (session) untuk migrasi Prisma.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://USER:PASSWORD@HOST.pooler.supabase.com:5432/postgres

# Batasi koneksi Prisma. Kosongkan untuk default otomatis:
#   host lokal (127.0.0.1) -> 10 | host pooler -> 1
# PRISMA_CONNECTION_LIMIT=10

# JWT configuration
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Key untuk enkripsi kredensial akun Akulaku (32+ karakter, jangan diganti setelah ada data)
AKULAKU_ENC_KEY=your_akulaku_encryption_key_here

# ---- Akulaku browser automation (Fase 3) ----
# Semua selektor bisa berubah sewaktu-waktu; sesuaikan dengan UI Seller Center.
# Login interaktif (sekali, untuk lewati OTP): npm run akulaku:login -- <accountId>
#
# BROWSER WAJIB DI-INSTALL DI SERVER (bukan sekadar `npm i playwright`):
#   npx playwright install --with-deps chromium
# Di VPS/Docker tanpa `--with-deps` Chromium bisa gagal jalan karena kurang
# library sistem. `npm ci` sudah otomatis menjalankan `postinstall` -> install
# chromium, tetapi `--with-deps` (lib OS) tetap perlu dijalankan manual sekali
# di image/OS yang belum punya dependensi Chromium.
AKULAKU_BASE_URL=https://ec-vendor.akulaku.com/ec-vendor
AKULAKU_LOGIN_PATH=/user/login
AKULAKU_USERNAME_SELECTOR=#login_email
AKULAKU_PASSWORD_SELECTOR=#login_pwd
AKULAKU_LOGIN_SUBMIT_SELECTOR=button[type="submit"]
AKULAKU_LOGGED_IN_SELECTOR=
AKULAKU_HEADLESS=true

# ---- Login Akulaku lewat aplikasi (kredensial otomatis + OTP) ----
# Dipakai bila Akulaku meminta verifikasi OTP. Sesuaikan bila UI berubah.
AKULAKU_OTP_INPUT_SELECTOR=input[maxlength="1"], input#code, input[name="code"], input[name="otp"], input[inputmode="numeric"]
AKULAKU_OTP_SUBMIT_SELECTOR=
AKULAKU_OTP_TEXT=verifikasi keamanan
AKULAKU_LOGIN_TTL_MS=600000

# Halaman form posting produk (diverifikasi ke UI asli Akulaku)
AKULAKU_POST_URL=/product/create
AKULAKU_POST_NAME_SELECTOR=#name
AKULAKU_POST_CATEGORY_SELECTOR=#categoryListValue
AKULAKU_POST_BRAND_SELECTOR=#brandId
AKULAKU_POST_PRICE_SELECTOR=#skus_0_originalPrice
AKULAKU_POST_STOCK_SELECTOR=#skus_0_stock
AKULAKU_POST_SKU_SELECTOR=#skus_0_goodsInfos
AKULAKU_POST_WEIGHT_SELECTOR=#weight
AKULAKU_POST_LENGTH_SELECTOR=#length
AKULAKU_POST_WIDTH_SELECTOR=#width
AKULAKU_POST_HEIGHT_SELECTOR=#height
AKULAKU_POST_IMAGE_INPUT_SELECTOR=input[type="file"]
AKULAKU_POST_SUBMIT_TEXT=Submit Produk
AKULAKU_POST_SUCCESS_SELECTOR=

# ---- Kategori otomatis (tabel AkulakuCategory + CategoryRule) ----
# Endpoint API kategori Akulaku (dipakai scripts/scrapeCategories.js).
AKULAKU_CATEGORY_API_MATCH=/goods/category/tree

# Isian wajib Akulaku lintas kategori saat posting (dipakai bila listing tidak punya).
# PENTING: berat memakai SATUAN KG (valid 0.01–999.9), dimensi dalam cm.
AKULAKU_POST_DEFAULT_WEIGHT=1
AKULAKU_POST_DEFAULT_LENGTH=10
AKULAKU_POST_DEFAULT_WIDTH=10
AKULAKU_POST_DEFAULT_HEIGHT=10
AKULAKU_POST_DEFAULT_STOCK=100
# Set 'true' untuk memakai stok asli produk (bila ada); default: selalu 100.
AKULAKU_POST_USE_PRODUCT_STOCK=false
# Merek & Bahan wajib; isian default bila tidak ditentukan per listing.
AKULAKU_POST_DEFAULT_BRAND=Tidak Ada Merek
AKULAKU_POST_DEFAULT_MATERIAL=Polyester
AKULAKU_POST_DEFAULT_COUNTRY=Indonesia

# Halaman daftar order
AKULAKU_ORDERS_URL=/order/listAKULAKU_ORDERS_ROW_SELECTOR=tbody tr
AKULAKU_ORDER_ID_SELECTOR=
AKULAKU_ORDER_ROW_LIMIT=20

# Worker
WORKER_POLL_INTERVAL_MS=5000

# Auto-sync pesanan (worker akan enqueue sync_orders berkala tanpa klik manual)
AUTO_SYNC_ORDERS=true
AUTO_SYNC_INTERVAL_MS=300000

# ---- Keamanan ----
# Beberapa origin dipisah koma. Di production WAJIB diisi (jangan dikosongkan).
CORS_ORIGIN=http://localhost:5173
# Di VPS di belakang nginx: set 1 (atau jumlah hop proxy)
TRUST_PROXY=1
# Batas ukuran body request
BODY_LIMIT=1mb
# Rate limit umum (/api)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
# Rate limit autentikasi (login/refresh) — hanya hitung yang gagal
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ---- Backup otomatis (khusus SUPERADMIN di halaman Monitor) ----
# Backup disimpan sebagai .json.gz di folder BACKUP_DIR (default: Backend/backups).
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_HOURS=24
# Jumlah file backup yang disimpan (yang lebih lama dihapus otomatis)
BACKUP_RETENTION_KEEP=14
# AuditLog & RequestMetric lebih tua dari ini akan dihapus otomatis
LOG_RETENTION_DAYS=30
# BACKUP_DIR=/var/backups/enzyy

# ---- Import produk Shopee (background) ----
# Lanjutkan otomatis saat server start bila sebelumnya masih 'running'
SHOPEE_IMPORT_AUTORESUME=true
SHOPEE_IMPORT_BATCH_SIZE=100
SHOPEE_IMPORT_DELAY_MS=150
# Lokasi file SQLite hasil scraping (default: Backend/shopee.db)
# SHOPEE_DB_PATH=/opt/shopee_scraping/shopee.db
