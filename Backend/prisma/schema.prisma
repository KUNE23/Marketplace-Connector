generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            BigInt         @id @default(autoincrement())
  email         String         @unique
  passwordHash  String
  name          String?
  role          String         @default("user")
  active        Boolean        @default(true)
  refreshTokens RefreshToken[]
  notifications Notification[]
  ownedAccounts AkulakuAccount[]
}

model RefreshToken {
  id        BigInt   @id @default(autoincrement())
  tokenHash String   @unique
  userId    BigInt
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
}

model RawShopee {
  id        BigInt   @id @default(autoincrement())
  payload   Json
  fetchedAt DateTime @default(now()) @db.Timestamptz
}

model FieldMap {
  shopeeKey   String @id
  akulakuKey  String
  transformJs String?
}

model Product {
  id            BigInt          @id @default(autoincrement())
  shopeeItemId  BigInt?         @unique
  sku           String?
  name          String?
  description   String?
  priceIdr      Decimal?
  stock         Int?
  shopeeUrl     String?
  shopId        String?
  location      String?
  sold          Int?
  rating        Decimal?        @db.Decimal(3, 2)
  imageUrls     String[]
  lastSyncedAt  DateTime?       @db.Timestamptz
  syncLogs      SyncLog[]
  saleItems     SaleOrderItem[]
  listings      Listing[]
}

model AkulakuAccount {
  id         BigInt    @id @default(autoincrement())
  label      String    @db.VarChar(100)
  username   String    @db.VarChar(150)
  passwordEnc String
  status     String    @default("active") @db.VarChar(20)
  note       String?
  // Pemilik akun (pegawai yang membuat/mengelola). null = dipegang admin lama.
  // Pegawai hanya melihat akun miliknya; admin melihat semua.
  ownerId    BigInt?
  owner      User?     @relation(fields: [ownerId], references: [id])
  listings   Listing[]
  orders     AkulakuOrder[]
  session    AkulakuSession?
  adSpends   AdSpend[]
  violations Violation[]
  violationSummaries ViolationSummary[]
  chatConversations  ChatConversation[]
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @updatedAt @db.Timestamptz

  @@index([ownerId])
}

// Jembatan produk Shopee -> akun Akulaku, dengan markup harga & status posting.
model Listing {
  id              BigInt          @id @default(autoincrement())
  productId       BigInt
  product         Product         @relation(fields: [productId], references: [id])
  accountId       BigInt
  account         AkulakuAccount  @relation(fields: [accountId], references: [id])
  basePrice       Decimal         @db.Decimal(14, 2)
  markupType      String          @default("percent") @db.VarChar(10) // percent | fixed
  markupValue     Decimal         @db.Decimal(14, 2)
  sellingPrice    Decimal         @db.Decimal(14, 2)
  status          String          @default("draft") @db.VarChar(20) // draft | queued | posted | failed
  // Kategori marketplace Akulaku (jalur cascader) & spesifikasi khas kategori.
  categoryPath    String?
  specs           Json?
  akulakuProductId String?        @db.VarChar(150)
  akulakuUrl      String?
  errorMessage    String?
  retryCount      Int             @default(0)
  postedAt        DateTime?       @db.Timestamptz
  createdAt       DateTime        @default(now()) @db.Timestamptz
  updatedAt       DateTime        @updatedAt @db.Timestamptz

  orderItems      AkulakuOrderItem[]

  @@unique([productId, accountId])
}

model SaleOrder {
  id         BigInt            @id @default(autoincrement())
  shopName   String?           @db.VarChar(100)
  externalId String?           @unique
  currency   String            @default("IDR")
  shopId     BigInt?  
  shop       Shop?             @relation(fields: [shopId], references: [id])
  status     String
  totalAmt   Decimal           @db.Decimal(12, 2)
  soldAt     DateTime          @db.Timestamptz
  syncedAt   DateTime          @default(now()) @db.Timestamptz
  items      SaleOrderItem[]
}

// Order dari marketplace Akulaku (inbound). Terpisah dari order Shopee.
model AkulakuOrder {
  id             BigInt              @id @default(autoincrement())
  externalId     String              @unique @db.VarChar(150) // order id Akulaku
  accountId      BigInt
  account        AkulakuAccount      @relation(fields: [accountId], references: [id])
  buyerName      String?             @db.VarChar(150)
  buyerPhone     String?             @db.VarChar(50)
  shippingAddress String?
  status         String              @default("new") @db.VarChar(30) // new | processing | shipped | delivered | cancelled
  totalAmt       Decimal             @db.Decimal(14, 2)
  currency       String              @default("IDR")
  orderedAt      DateTime            @db.Timestamptz
  syncedAt       DateTime            @default(now()) @db.Timestamptz
  updatedAt      DateTime            @updatedAt @db.Timestamptz
  rawPayload     Json?
  items          AkulakuOrderItem[]
  extra          AkulakuOrderExtra?
}

model AkulakuOrderItem {
  id        BigInt        @id @default(autoincrement())
  orderId   BigInt
  order     AkulakuOrder  @relation(fields: [orderId], references: [id])
  listingId BigInt?
  listing   Listing?      @relation(fields: [listingId], references: [id])
  sku       String?       @db.VarChar(150)
  name      String?       @db.VarChar(255)
  qty       Int
  unitPrice Decimal       @db.Decimal(14, 2)
  total     Decimal       @db.Decimal(14, 2)
  imageUrl  String?       @db.VarChar(500)
  variant   String?       @db.VarChar(200)
}

model SaleOrderItem {
  id        BigInt    @id @default(autoincrement())
  orderId   BigInt
  product   Product   @relation(fields: [productId], references: [id])
  productId BigInt
  qty       Int
  unitPrice Decimal   @db.Decimal(12, 2)
  discount  Decimal?  @db.Decimal(12, 2)
  total     Decimal   @db.Decimal(12, 2)
  order     SaleOrder @relation(fields: [orderId], references: [id])
}

model Shop {
  id        BigInt         @id @default(autoincrement())
  shopName  String         @unique @db.VarChar(100)
  shopId    String         @unique
  orders    SaleOrder[]
  sales     SaleSummary[]
  createdAt DateTime       @default(now()) @db.Timestamptz
}

model SaleSummary {
  id      BigInt   @id @default(autoincrement())
  period  DateTime @db.Date
  shopId  BigInt
  shop    Shop?    @relation(fields: [shopId], references: [id])
  qty     Int
  revenue Decimal  @db.Decimal(14, 2)
  @@unique([period, shopId])
}

model Notification {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt?
  user      User?    @relation(fields: [userId], references: [id])
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(200)
  body      String?
  readAt    DateTime?
  createdAt DateTime @default(now()) @db.Timestamptz
}

model SyncLog {
  id           BigInt   @id @default(autoincrement())
  productId    BigInt
  product      Product @relation(fields: [productId], references: [id])
  status       String
  responseCode Int?
  responseBody Json?
  runAt        DateTime @default(now()) @db.Timestamptz
}

// Antrian pekerjaan worker (posting listing / sync order).
model Job {
  id          BigInt    @id @default(autoincrement())
  type        String    @db.VarChar(40) // post_listing | sync_orders
  payload     Json?
  status      String    @default("pending") @db.VarChar(20) // pending | running | done | failed
  priority    Int       @default(0)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?
  runAt       DateTime  @default(now()) @db.Timestamptz
  startedAt   DateTime? @db.Timestamptz
  finishedAt  DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  @@index([status, runAt])
}

// Sesi login Akulaku per akun (storage state Playwright), terenkripsi.
model AkulakuSession {
  id        BigInt          @id @default(autoincrement())
  accountId BigInt          @unique
  account   AkulakuAccount  @relation(fields: [accountId], references: [id])
  stateEnc  String?
  status    String          @default("missing") @db.VarChar(20) // missing | valid | expired
  updatedAt DateTime        @updatedAt @db.Timestamptz
  createdAt DateTime        @default(now()) @db.Timestamptz
}

// Progres import produk dari shopee.db (cursor-based, bisa lanjut).
model ImportState {
  id            BigInt   @id @default(autoincrement())
  source        String   @unique @db.VarChar(50) // shopee_db
  lastRowId     Int      @default(0)
  imported      Int      @default(0)
  updated       Int      @default(0)
  skipped       Int      @default(0)
  failed        Int      @default(0)
  status        String   @default("idle") @db.VarChar(20) // idle | running | done
  lastError     String?
  startedAt     DateTime? @db.Timestamptz
  finishedAt    DateTime? @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz
}

// Aturan markup harga bertingkat (persen), dipakai otomatis saat membuat listing
// bila markup tidak diisi manual.
model MarkupTier {
  id          BigInt   @id @default(autoincrement())
  label       String   @db.VarChar(100)
  minPrice    Decimal  @db.Decimal(14, 2)
  maxPrice    Decimal? @db.Decimal(14, 2) // null = tak terbatas
  markupType  String   @default("percent") @db.VarChar(10)
  markupValue Decimal  @db.Decimal(14, 2)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz
}

// Biaya iklan (ad spend) untuk perhitungan profit bersih.
// accountId null = "Umum" (berlaku untuk semua akun).
model AdSpend {
  id        BigInt           @id @default(autoincrement())
  accountId BigInt?
  account   AkulakuAccount?  @relation(fields: [accountId], references: [id])
  period    DateTime         @db.Date // tanggal biaya iklan
  amount    Decimal          @db.Decimal(14, 2)
  note      String?
  createdAt DateTime         @default(now()) @db.Timestamptz
  updatedAt DateTime         @updatedAt @db.Timestamptz

  @@index([period])
  @@index([accountId])
}

// Daftar kategori Akulaku (hasil scrape API /goods/category/tree).
// path = jalur cascader dipisah "/", contoh: "Tas dan penyimpanan/Tas Pria/Tas ransel".
model AkulakuCategory {
  id        BigInt   @id @default(autoincrement())
  path      String   @unique @db.VarChar(500)
  akulakuId String?  @db.VarChar(50) // id leaf dari Akulaku
  level     Int      @default(1)
  rootName  String?  @db.VarChar(150)
  scrapedAt DateTime @default(now()) @db.Timestamptz

  @@index([rootName])
  @@index([level])
}

// Aturan pemetaan otomatis nama produk -> kategori Akulaku.
model CategoryRule {
  id       BigInt   @id @default(autoincrement())
  keyword  String   @db.VarChar(200)
  path     String   @db.VarChar(500)
  priority Int      @default(0)
  active   Boolean  @default(true)
  note     String?  @db.VarChar(300)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([keyword])
  @@index([priority])
}

// Catatan pelanggaran toko Akulaku (hasil sinkron dari Seller Center).
// Skor/denda disimpan per periode penilaian yang diberikan Akulaku.
model Violation {
  id           BigInt          @id @default(autoincrement())
  accountId    BigInt
  account      AkulakuAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Jenis pelanggaran dari Akulaku (violationTypeList).
  violationKey String          @db.VarChar(150) // gabungan firstClassificationId:secondClassificationId
  name         String          @db.VarChar(255) // secondLevelName / noteDetail
  category     String?         @db.VarChar(150) // klasifikasi pertama (Produk/Pesanan/Layanan/...)
  note         String?         @db.VarChar(500)
  // Angka dari Akulaku (null = tidak ada pelanggaran pada kategori tsb).
  score        Int?            // pengurangan skor
  penalty      Decimal?        @db.Decimal(14, 2) // denda
  count        Int?            // jumlah kejadian
  severity     String          @default("info") @db.VarChar(20) // info | warning | critical
  periodStart  DateTime?       @db.Timestamptz
  periodEnd    DateTime?       @db.Timestamptz
  rawPayload   Json?
  detectedAt   DateTime        @default(now()) @db.Timestamptz
  syncedAt     DateTime        @updatedAt @db.Timestamptz

  @@unique([accountId, violationKey])
  @@index([accountId])
  @@index([detectedAt])
}

// Snapshot ringkasan kondisi toko (skor toko & total denda) per akun per sync.
// Dipakai untuk melihat tren & kondisi terkini di halaman Pelanggaran.
model ViolationSummary {
  id             BigInt          @id @default(autoincrement())
  accountId      BigInt
  account        AkulakuAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shopScore      Int?            // shopIntegral
  totalScore     Int?            // akumulasi pengurangan skor
  totalPenalty   Decimal?        @db.Decimal(14, 2)
  violationCount Int             @default(0)
  condition      String?         @db.VarChar(100) // ringkasan kondisi (mis. "sangat baik")
  assessmentCycle String?        @db.VarChar(100)
  rawPayload     Json?
  capturedAt     DateTime        @default(now()) @db.Timestamptz

  @@index([accountId, capturedAt])
}

// Percakapan LiveChat Akulaku dengan buyer (hasil sinkron dari UI LiveChat).
model ChatConversation {
  id            BigInt          @id @default(autoincrement())
  accountId     BigInt
  account       AkulakuAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  convKey       String          @db.VarChar(255) // penanda unik percakapan dalam akun
  buyerLabel    String          @db.VarChar(150) // nama/nomor buyer (bisa disamarkan Akulaku)
  lastPreview   String?         @db.VarChar(500)
  lastMessageAt DateTime?       @db.Timestamptz
  unread        Int             @default(0)
  messages      ChatMessage[]
  createdAt     DateTime        @default(now()) @db.Timestamptz
  updatedAt     DateTime        @updatedAt @db.Timestamptz

  @@unique([accountId, convKey])
  @@index([accountId])
  @@index([lastMessageAt])
}

// Pesan dalam percakapan LiveChat.
model ChatMessage {
  id             BigInt           @id @default(autoincrement())
  conversationId BigInt
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  msgKey         String           @db.VarChar(200) // kunci dedupe
  from           String           @db.VarChar(10) // us | buyer
  sender         String?          @db.VarChar(150)
  text           String
  createdAt      DateTime         @default(now()) @db.Timestamptz

  @@unique([conversationId, msgKey])
  @@index([conversationId])
}

// Kolom hasil ekstraksi dari rawPayload Akulaku (gambar, varian, pembayaran).
// Dipisah agar bisa di-query & ditampilkan tanpa parse JSON tiap kali.
model AkulakuOrderExtra {
  id             BigInt        @id @default(autoincrement())
  orderId        BigInt        @unique
  order          AkulakuOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payType        Int?
  payTypeLabel   String?       @db.VarChar(50)
  orderCode      String?       @db.VarChar(100)
  orderType      Int?
  refundStatus   Int?
  deliveryStatus Int?
  isCod          Boolean       @default(false)
  payTime        DateTime?     @db.Timestamptz
  createTime     DateTime?     @db.Timestamptz
  updatedAt      DateTime      @updatedAt @db.Timestamptz
}

// Audit trail aktivitas user (login, perubahan data, perubahan role).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt?
  userEmail  String?  @db.VarChar(200)
  userRole   String?  @db.VarChar(30)
  action     String   @db.VarChar(100) // login | create | update | delete | role_change | ...
  resource   String?  @db.VarChar(100) // users | listings | akulaku-accounts | ...
  resourceId String?  @db.VarChar(100)
  status     String   @default("success") @db.VarChar(20) // success | failed
  ip         String?  @db.VarChar(60)
  userAgent  String?  @db.VarChar(300)
  detail     Json?
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@index([resource])
}

// Metrik request HTTP (untuk halaman Monitor: kecepatan, endpoint tersibuk, error rate).
model RequestMetric {
  id         BigInt   @id @default(autoincrement())
  method     String   @db.VarChar(10)
  path       String   @db.VarChar(200)
  statusCode Int
  durationMs Int
  userId     BigInt?
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([createdAt])
  @@index([path])
  @@index([statusCode])
}
