# Skrip shell WAJIB LF. Kalau tersimpan CRLF, Linux akan menolak menjalankannya
# dengan error "bad interpreter: /usr/bin/env: 'bash\r'".
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf

# File Node/Vue biarkan mengikuti platform
*.js   text
*.ts   text
*.vue  text
*.json text
*.md   text
*.prisma text
